<!-- Velotext: shared MSBuild settings for every project (language, analyzers, documentation, versioning). -->
<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Descriptions are mandatory: missing XML docs on public members (CS1591) fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Velotext</Product>
    <Company>Velotext contributors</Company>
    <Authors>Velotext contributors</Authors>
    <Copyright>Copyright (c) 2026 Velotext contributors</Copyright>
    <VersionPrefix>1.0.0</VersionPrefix>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Lock files pin every package, direct and transitive, by content hash. CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- The installer is built for win-x64 and publish passes that runtime to every referenced project, so the lock files list it. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- CI and release builds embed no local file paths (PDB paths become /_/). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(VelotextRelease)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
