<!-- Velotext: Windows integration (keyboard hook, input injection, clipboard, hotkeys, autostart, expansion engine). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Velotext.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Windows integration for Velotext: low-level keyboard hook, input injection, clipboard, global hotkeys, autostart and the expansion engine.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Velotext.Core\Velotext.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Velotext.Platform.Windows.Tests" />
  </ItemGroup>
</Project>
