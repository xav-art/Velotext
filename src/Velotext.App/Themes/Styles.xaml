<!-- Velotext: shared styles built on the Fluent theme (icons, labels, toolbar and formatting buttons, option chips). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:editing="clr-namespace:Velotext.App.Editing"
                    xmlns:views="clr-namespace:Velotext.App.Views">
  <FontFamily x:Key="Velotext.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Velotext.UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
  <sys:Double x:Key="Velotext.CaptionSize">12</sys:Double>
  <sys:Double x:Key="Velotext.BodySize">14</sys:Double>
  <sys:Double x:Key="Velotext.SubtitleSize">17</sys:Double>
  <sys:Double x:Key="Velotext.TitleSize">20</sys:Double>

  <Style x:Key="Velotext.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Velotext.IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Velotext.SectionLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Velotext.CaptionSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="Velotext.Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Velotext.CaptionSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Velotext.ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>

  <Style x:Key="Velotext.IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>

  <Style x:Key="Velotext.FormatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>

  <Style x:Key="Velotext.FormatToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0,0,2,0" />
  </Style>

  <!-- Option chip: an outlined pill. When on, it shows a check mark and the accent outline, so the state is not shown by colour alone. -->
  <Style x:Key="Velotext.Chip" TargetType="ToggleButton">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="FontSize" Value="{StaticResource Velotext.CaptionSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <!-- The unchecked outline uses the strong stroke, so the chip edge has 3:1 contrast. -->
    <Setter Property="BorderBrush" Value="{DynamicResource Velotext.StrokeStrong}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Pill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <views:Glyph x:Name="Check" Style="{StaticResource Velotext.Icon}" Text="&#xE73E;" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" />
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <!-- Keyboard focus ring, drawn outside the pill. -->
            <Border x:Name="FocusRing" Margin="-3" CornerRadius="17" BorderThickness="2" Visibility="Collapsed"
                    BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The hotkey box is a TextBox subclass, which implicit TextBox styles do not reach. -->
  <Style TargetType="editing:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}" />
</ResourceDictionary>
