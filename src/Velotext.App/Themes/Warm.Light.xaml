<!-- Velotext: warm light palette. Defines Velotext tokens and overrides the Fluent theme's neutral brushes: warm neutrals tinted toward orange, the Windows accent for highlights, text contrast of 4.5:1 or more. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Velotext.BgColor">#F7F4F0</Color>
  <Color x:Key="Velotext.SurfaceColor">#FBF9F6</Color>
  <Color x:Key="Velotext.RaisedColor">#FFFFFF</Color>
  <Color x:Key="Velotext.HoverColor">#F0EBE5</Color>
  <Color x:Key="Velotext.PressedColor">#E9E3DC</Color>
  <Color x:Key="Velotext.StrokeSubtleColor">#E4DDD5</Color>
  <Color x:Key="Velotext.StrokeColor">#D6CEC5</Color>
  <Color x:Key="Velotext.StrokeStrongColor">#8C827A</Color>
  <Color x:Key="Velotext.TextColor">#221E1B</Color>
  <Color x:Key="Velotext.TextMutedColor">#4F4842</Color>
  <Color x:Key="Velotext.TextFaintColor">#6B635C</Color>
  <Color x:Key="Velotext.TextDisabledColor">#A39A91</Color>
  <Color x:Key="Velotext.OkColor">#1E7A3C</Color>
  <Color x:Key="Velotext.WarnColor">#8A5A00</Color>
  <Color x:Key="Velotext.ErrColor">#B3261E</Color>

  <SolidColorBrush x:Key="Velotext.Bg" Color="{StaticResource Velotext.BgColor}" />
  <SolidColorBrush x:Key="Velotext.Surface" Color="{StaticResource Velotext.SurfaceColor}" />
  <SolidColorBrush x:Key="Velotext.Raised" Color="{StaticResource Velotext.RaisedColor}" />
  <SolidColorBrush x:Key="Velotext.Hover" Color="{StaticResource Velotext.HoverColor}" />
  <SolidColorBrush x:Key="Velotext.StrokeSubtle" Color="{StaticResource Velotext.StrokeSubtleColor}" />
  <SolidColorBrush x:Key="Velotext.StrokeStrong" Color="{StaticResource Velotext.StrokeStrongColor}" />
  <SolidColorBrush x:Key="Velotext.Text" Color="{StaticResource Velotext.TextColor}" />
  <SolidColorBrush x:Key="Velotext.TextMuted" Color="{StaticResource Velotext.TextMutedColor}" />
  <SolidColorBrush x:Key="Velotext.TextFaint" Color="{StaticResource Velotext.TextFaintColor}" />
  <SolidColorBrush x:Key="Velotext.Ok" Color="{StaticResource Velotext.OkColor}" />
  <SolidColorBrush x:Key="Velotext.Warn" Color="{StaticResource Velotext.WarnColor}" />
  <SolidColorBrush x:Key="Velotext.Err" Color="{StaticResource Velotext.ErrColor}" />

  <!-- Fluent neutral overrides: warm instead of cool grey. -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Velotext.BgColor}" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Velotext.BgColor}" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource Velotext.BgColor}" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Velotext.SurfaceColor}" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Velotext.RaisedColor}" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource Velotext.HoverColor}" />
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource Velotext.SurfaceColor}" />
  <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource Velotext.RaisedColor}" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Velotext.SurfaceColor}" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Velotext.RaisedColor}" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Velotext.RaisedColor}" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Velotext.HoverColor}" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Velotext.PressedColor}" />
  <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource Velotext.PressedColor}" />
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource Velotext.RaisedColor}" />
  <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource Velotext.RaisedColor}" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Velotext.HoverColor}" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Velotext.PressedColor}" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Velotext.StrokeColor}" />
  <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource Velotext.StrokeColor}" />
  <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource Velotext.StrokeStrongColor}" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Velotext.StrokeSubtleColor}" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource Velotext.StrokeSubtleColor}" />
  <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource Velotext.StrokeSubtleColor}" />
  <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{StaticResource Velotext.StrokeSubtleColor}" />
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Velotext.TextColor}" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Velotext.TextMutedColor}" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Velotext.TextFaintColor}" />
  <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Velotext.TextDisabledColor}" />
</ResourceDictionary>
