<!-- Velotext: the desktop application (WPF UI, tray icon, settings, composition root). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Velotext.App</RootNamespace>
    <AssemblyName>Velotext</AssemblyName>
    <ApplicationIcon>Assets\velotext.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Velotext.App.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- XML docs are needed at build time (missing descriptions fail the build) but not at run time. -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <Description>Velotext: a per-user text expander for Windows. Type a short trigger and Velotext inserts the formatted phrase.</Description>
    <!-- Memory: Velotext waits in the tray most of the day with a small heap, so it uses the plain blocking
         collector (no background GC thread and its bookkeeping) and no profile-guided JIT instrumentation.
         A full collection of this heap takes a few milliseconds. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compacts more eagerly instead of growing the heap when memory is fragmented (0 = off, 9 = most). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Velotext.Core\Velotext.Core.csproj" />
    <ProjectReference Include="..\Velotext.Platform.Windows\Velotext.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The license and third-party notices travel with every copy of the app (MIT and Apache-2.0 require it). -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- A self-contained app ships the .NET runtime, so it also ships the runtime's own third-party notices. -->
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <PropertyGroup>
      <RuntimeNoticesFile>$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(RuntimeIdentifier)\$(BundledNETCoreAppPackageVersion)\THIRD-PARTY-NOTICES.TXT</RuntimeNoticesFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(RuntimeNoticesFile)')" Text="The .NET runtime notices were not found at $(RuntimeNoticesFile)." />
    <Copy SourceFiles="$(RuntimeNoticesFile)" DestinationFiles="$(PublishDir)DOTNET-THIRD-PARTY-NOTICES.TXT" />
  </Target>
  <ItemGroup>
    <Resource Include="Assets\*.ico" />
    <Resource Include="Assets\*.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Program.Main is the entry point, so App.xaml is a plain page (no generated Main). -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Velotext.App.Tests" />
  </ItemGroup>
</Project>
