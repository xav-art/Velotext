<!-- Velotext: the main window: toolbar and search, phrase tree, phrase editor and status bar. -->
<Window x:Class="Velotext.App.Views.MainWindow"
        Background="{DynamicResource Velotext.Bg}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Velotext.App.ViewModels"
        xmlns:views="clr-namespace:Velotext.App.Views"
        xmlns:editing="clr-namespace:Velotext.App.Editing"
        Title="Velotext"
        Width="1120" Height="740" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Velotext.UiFont}"
        FontSize="{StaticResource Velotext.BodySize}"
        Icon="/Velotext;component/Assets/velotext.ico">
  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="Visible" />
    <views:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
    <views:NullToVisibilityConverter x:Key="VisibleWhenSet" />
    <views:NullToVisibilityConverter x:Key="VisibleWhenNull" Invert="True" />
    <views:EnumIndexConverter x:Key="EnumIndex" />

    <Style x:Key="TreeRowText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TreeTriggerText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,4,0" />
      <Setter Property="FontSize" Value="{StaticResource Velotext.CaptionSize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Problem marker: red error glyph for errors, amber warning glyph for warnings. -->
    <Style x:Key="ProblemGlyph" TargetType="views:Glyph" BasedOn="{StaticResource Velotext.Icon}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Text" Value="&#xE7BA;" />
      <Setter Property="Foreground" Value="{DynamicResource Velotext.Warn}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasErrors}" Value="True">
          <Setter Property="Text" Value="&#xEA39;" />
          <Setter Property="Foreground" Value="{DynamicResource Velotext.Err}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type vm:ShortcutFolderViewModel}" ItemsSource="{Binding Items}">
      <StackPanel Orientation="Horizontal" Height="28" Background="Transparent" ToolTip="{Binding Description}">
        <views:Glyph Style="{StaticResource Velotext.Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" />
        <TextBlock Style="{StaticResource TreeRowText}" Text="{Binding DisplayName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type vm:ShortcutHintViewModel}">
      <TextBlock Height="28" Style="{StaticResource TreeRowText}" Text="{Binding DisplayName}" FontSize="{StaticResource Velotext.CaptionSize}"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </DataTemplate>

    <HierarchicalDataTemplate DataType="{x:Type vm:FolderViewModel}" ItemsSource="{Binding Children}">
      <Grid Height="28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE8B7;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" Style="{StaticResource TreeRowText}" Text="{Binding DisplayName}" FontWeight="SemiBold"
                   Visibility="{Binding IsRenaming, Converter={StaticResource Hidden}}" />
        <TextBox Grid.Column="1" MinWidth="160" Padding="8,4" VerticalAlignment="Center"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}"
                 AutomationProperties.Name="Folder name"
                 IsVisibleChanged="OnRenameBoxVisible" KeyDown="OnRenameBoxKeyDown" LostKeyboardFocus="OnRenameBoxLostFocus" />
      </Grid>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type vm:PhraseViewModel}">
      <Grid Height="28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE8A5;" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" Style="{StaticResource TreeRowText}" Text="{Binding DisplayName}" />
        <TextBlock Grid.Column="2" Style="{StaticResource TreeTriggerText}" Text="{Binding TriggerSummary}" />
        <views:Glyph Grid.Column="3" Style="{StaticResource ProblemGlyph}" Margin="4,0,0,0"
                     Visibility="{Binding HasProblems, Converter={StaticResource Visible}}"
                     ToolTip="This phrase has a trigger problem" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ShortcutViewModel}">
      <Grid Height="28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE8A5;" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" Style="{StaticResource TreeRowText}" Text="{Binding DisplayName}" />
        <TextBlock Grid.Column="2" Style="{StaticResource TreeTriggerText}" Text="{Binding TriggerSummary}" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewPhraseCommand}" />
    <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewFolderCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
    <KeyBinding Key="M" Modifiers="Control+Shift" Command="{Binding MoveToFolderCommand}" />
    <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding TogglePauseCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Banner: a damaged library file, or saving that does not work -->
    <Border Margin="12,12,12,0" Padding="16,8" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource Velotext.Raised}"
            Visibility="{Binding Banner, Converter={StaticResource VisibleWhenSet}}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{DynamicResource Velotext.Warn}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsBannerError}" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource Velotext.Err}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <views:Glyph Margin="0,0,12,0">
          <views:Glyph.Style>
            <Style TargetType="views:Glyph" BasedOn="{StaticResource Velotext.Icon}">
              <Setter Property="Text" Value="&#xE7BA;" />
              <Setter Property="Foreground" Value="{DynamicResource Velotext.Warn}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                  <Setter Property="Text" Value="&#xEA39;" />
                  <Setter Property="Foreground" Value="{DynamicResource Velotext.Err}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:Glyph.Style>
        </views:Glyph>
        <Button DockPanel.Dock="Right" Content="Close message" Command="{Binding DismissBannerCommand}" />
        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <!-- Toolbar -->
    <DockPanel Grid.Row="1" Margin="12,8,12,8" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="New phrase" Command="{Binding NewPhraseCommand}" Padding="12,4" MinHeight="32" Margin="0,0,8,0"
                ToolTip="New phrase (Ctrl+N)">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="New phrase" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Velotext.ToolbarButton}" AutomationProperties.Name="New folder" Command="{Binding NewFolderCommand}" ToolTip="New folder (Ctrl+Shift+N)">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE8F4;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="New folder" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Velotext.ToolbarButton}" AutomationProperties.Name="Duplicate phrase" Command="{Binding DuplicateCommand}" ToolTip="Duplicate the phrase without its triggers (Ctrl+D)">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE8C8;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Duplicate" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Velotext.ToolbarButton}" AutomationProperties.Name="Delete" Command="{Binding DeleteCommand}" ToolTip="Delete the selected phrase or folder (Del)">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Delete" />
          </StackPanel>
        </Button>
        <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource Velotext.StrokeSubtle}" />
        <Button Style="{StaticResource Velotext.ToolbarButton}" AutomationProperties.Name="Import phrases" Command="{Binding ImportCommand}" ToolTip="Import phrases from a Velotext file">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Import" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Velotext.ToolbarButton}" AutomationProperties.Name="Export phrases" Command="{Binding ExportCommand}" ToolTip="Export the selected folder or phrase to a Velotext file">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE898;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Export" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Grid Width="240" Margin="0,0,8,0">
          <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,4,32,4"
                   AutomationProperties.Name="Search phrases" ToolTip="Search phrases (Ctrl+F)" KeyDown="OnSearchKeyDown" />
          <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE721;" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False" />
          <TextBlock Text="Search" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Visibility="{Binding SearchText, Converter={StaticResource VisibleWhenNull}}" />
          <Button Style="{StaticResource Velotext.IconButton}" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,4,0"
                  Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear search" ToolTip="Clear search (Esc)"
                  Visibility="{Binding SearchText, Converter={StaticResource VisibleWhenSet}}">
            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE711;" FontSize="12" />
          </Button>
        </Grid>
        <Button Style="{StaticResource Velotext.ToolbarButton}" AutomationProperties.Name="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" ToolTip="Pause or resume expansion (Ctrl+Shift+P)">
          <StackPanel Orientation="Horizontal">
            <views:Glyph FontSize="14" Margin="0,0,8,0">
              <views:Glyph.Style>
                <Style TargetType="views:Glyph" BasedOn="{StaticResource Velotext.Icon}">
                  <Setter Property="Text" Value="&#xE769;" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                      <Setter Property="Text" Value="&#xE768;" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </views:Glyph.Style>
            </views:Glyph>
            <TextBlock Text="{Binding PauseButtonText}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Velotext.IconButton}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings" ToolTip="Settings">
          <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE713;" />
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- Tree and editor -->
    <Grid Grid.Row="2" Margin="12,0,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="220" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="360" />
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource Velotext.Surface}" CornerRadius="10" Padding="4,8">
        <Grid>
          <TreeView x:Name="Tree"
                    ItemsSource="{Binding TreeRoots}"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="Phrase library"
                    VirtualizingPanel.IsVirtualizing="True"
                    SelectedItemChanged="OnTreeSelectionChanged"
                    KeyDown="OnTreeKeyDown"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="OnTreeMouseDown"
                    PreviewMouseRightButtonDown="OnTreeRightMouseDown"
                    PreviewMouseMove="OnTreeMouseMove"
                    DragOver="OnTreeDragOver"
                    DragLeave="OnTreeDragLeave"
                    Drop="OnTreeDrop">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource Visible}}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="New phrase" Command="{Binding NewPhraseCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" InputGestureText="Ctrl+Shift+N" />
                <Separator />
                <MenuItem Header="Rename" Command="{Binding RenameCommand}" InputGestureText="F2" />
                <MenuItem Header="Duplicate phrase" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D" />
                <MenuItem Header="Move to folder" Command="{Binding MoveToFolderCommand}" InputGestureText="Ctrl+Shift+M" />
                <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" InputGestureText="Alt+Up" />
                <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" InputGestureText="Alt+Down" />
                <Separator />
                <MenuItem Header="Export phrases" Command="{Binding ExportCommand}" />
                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGestureText="Del" />
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
          <StackPanel Margin="16" VerticalAlignment="Top" Visibility="{Binding HasNoMatches, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding NoMatchesText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Button Content="Clear search" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                    AutomationProperties.Name="Resize the phrase list" />

      <Border Grid.Column="2" Background="{DynamicResource Velotext.Surface}" CornerRadius="10">
        <Grid>
          <!-- Empty state -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                      Visibility="{Binding EditorPhrase, Converter={StaticResource VisibleWhenNull}}">
            <TextBlock Text="{Binding EmptyEditorTitle}" FontSize="{StaticResource Velotext.TitleSize}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EmptyEditorMessage}" Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button Content="New phrase" HorizontalAlignment="Center" Padding="16,4" Command="{Binding NewPhraseCommand}" />
          </StackPanel>

          <!-- Phrase editor: fills the panel, and scrolls when the window is too short -->
          <ScrollViewer x:Name="EditorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False"
                        Padding="24,16,24,16"
                        Visibility="{Binding EditorPhrase, Converter={StaticResource VisibleWhenSet}}">
          <Grid DataContext="{Binding EditorPhrase}" MinHeight="520"
                Height="{Binding ViewportHeight, ElementName=EditorScroller}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="120" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Velotext.SectionLabel}" Text="Name" />
            <StackPanel Grid.Row="1">
              <TextBox x:Name="NameBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                       FontSize="{StaticResource Velotext.SubtitleSize}" FontWeight="SemiBold" Padding="12,4"
                       AutomationProperties.Name="Phrase name"
                       AutomationProperties.HelpText="{Binding DataContext.EditorUsageText, RelativeSource={RelativeSource AncestorType=Window}}" />
              <TextBlock x:Name="UsageText" Text="{Binding DataContext.EditorUsageText, RelativeSource={RelativeSource AncestorType=Window}}"
                         Margin="0,8,0,0" FontSize="{StaticResource Velotext.CaptionSize}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Style="{StaticResource Velotext.SectionLabel}" Text="Text" Margin="0,24,0,8" />
            <editing:RichTextEditor x:Name="ContentEditor" Grid.Row="3"
                                    Phrase="{Binding}"
                                    EditorFontFamily="{Binding DataContext.EditorFontName, RelativeSource={RelativeSource AncestorType=Window}}"
                                    EditorFontSize="{Binding DataContext.EditorFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />

            <!-- Triggers -->
            <StackPanel Grid.Row="4" Margin="0,24,0,0">
              <TextBlock Style="{StaticResource Velotext.SectionLabel}" Text="Triggers" />
              <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                <ItemsControl ItemsSource="{Binding Triggers}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TriggerViewModel}">
                      <StackPanel Margin="0,0,0,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ComboBox SelectedIndex="{Binding Kind, Converter={StaticResource EnumIndex}}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Trigger type">
                            <ComboBoxItem Content="Typed text" />
                            <ComboBoxItem Content="Hotkey" />
                          </ComboBox>
                          <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="12,4"
                                   FontFamily="Cascadia Mono, Consolas"
                                   AutomationProperties.Name="Trigger text"
                                   Visibility="{Binding IsTypedText, Converter={StaticResource Visible}}" />
                          <editing:HotkeyBox Grid.Column="1" Gesture="{Binding Gesture}" Padding="12,4"
                                             AutomationProperties.Name="Hotkey"
                                             Visibility="{Binding IsHotkey, Converter={StaticResource Visible}}" />
                          <Button Grid.Column="2" Style="{StaticResource Velotext.IconButton}" Margin="4,0,0,0"
                                  Command="{Binding DataContext.RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}"
                                  AutomationProperties.Name="Delete trigger" ToolTip="Delete trigger">
                            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE711;" FontSize="12" />
                          </Button>
                        </Grid>
                        <WrapPanel Margin="148,8,0,0" Visibility="{Binding IsTypedText, Converter={StaticResource Visible}}">
                          <ToggleButton Style="{StaticResource Velotext.Chip}" IsChecked="{Binding CaseSensitive}" Content="Match case"
                                        ToolTip="Fires only when you type the same capital and small letters." />
                          <ToggleButton Style="{StaticResource Velotext.Chip}" IsChecked="{Binding Immediate}" Content="Expand immediately"
                                        ToolTip="Inserts the phrase when you type the last character. When off, Velotext waits for a space, Enter or punctuation." />
                          <ToggleButton Style="{StaticResource Velotext.Chip}" IsChecked="{Binding WordStart}" Content="Start of word"
                                        ToolTip="Fires only when the trigger starts a word." />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="148,8,0,0" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}">
                          <views:Glyph FontSize="12" Margin="0,0,8,0" VerticalAlignment="Top">
                            <views:Glyph.Style>
                              <Style TargetType="views:Glyph" BasedOn="{StaticResource Velotext.Icon}">
                                <Setter Property="Text" Value="&#xE7BA;" />
                                <Setter Property="Foreground" Value="{DynamicResource Velotext.Warn}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Text" Value="&#xEA39;" />
                                    <Setter Property="Foreground" Value="{DynamicResource Velotext.Err}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </views:Glyph.Style>
                          </views:Glyph>
                          <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" MaxWidth="560" FontSize="{StaticResource Velotext.CaptionSize}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Velotext.Warn}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Velotext.Err}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Velotext.ToolbarButton}" AutomationProperties.Name="Add typed text trigger" Command="{Binding AddTypedTriggerCommand}">
                  <StackPanel Orientation="Horizontal">
                    <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Add typed text" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource Velotext.ToolbarButton}" AutomationProperties.Name="Add hotkey trigger" Command="{Binding AddHotkeyTriggerCommand}">
                  <StackPanel Orientation="Horizontal">
                    <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE765;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Add hotkey" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>

            <!-- Where the phrase is inserted -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
              <TextBlock Text="Insert into" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ComboBox Width="220" SelectedIndex="{Binding Output, Converter={StaticResource EnumIndex}}" AutomationProperties.Name="Insert into">
                <ComboBoxItem Content="Active application" />
                <ComboBoxItem Content="Clipboard only" />
              </ComboBox>
            </StackPanel>
          </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar -->
    <DockPanel Grid.Row="3" Margin="20,8,20,8" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource Velotext.Ok}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                  <Setter Property="Fill" Value="{DynamicResource Velotext.Warn}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding ExpansionStatus}" VerticalAlignment="Center" FontSize="{StaticResource Velotext.CaptionSize}" />
        <TextBlock Text="{Binding PhraseCountText}" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Velotext.CaptionSize}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Button Margin="16,0,0,0" Padding="8,0" AutomationProperties.Name="{Binding ProblemButtonName}" Command="{Binding ShowNextProblemCommand}" Style="{StaticResource Velotext.ToolbarButton}"
                Visibility="{Binding ProblemCountText, Converter={StaticResource VisibleWhenSet}}" ToolTip="Show the next phrase with a trigger problem">
          <StackPanel Orientation="Horizontal">
            <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource Velotext.Warn}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ProblemCountText}" FontSize="{StaticResource Velotext.CaptionSize}" />
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <views:Glyph Style="{StaticResource Velotext.Icon}" Text="&#xEA39;" FontSize="12" Foreground="{DynamicResource Velotext.Err}" Margin="0,0,8,0"
                     Visibility="{Binding IsSaveFailed, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" FontSize="{StaticResource Velotext.CaptionSize}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
